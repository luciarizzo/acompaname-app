# Set true only when running with Netlify Functions (for example: npx netlify dev).
# If false, each provider uses clearly labeled local demonstration data.
VITE_ENABLE_LIVE_APIS=false

# Server-side secrets: configure in Netlify environment or local Netlify CLI environment.
# Never add real values to VITE_ variables or commit them.
DUFFEL_API_KEY=
GOOGLE_PLACES_API_KEY=
TICKETMASTER_API_KEY=
